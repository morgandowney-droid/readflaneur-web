import { untranslatedHeaders } from '../src/lib/translation-service';
let fail = 0;
const t = (name: string, ok: boolean) => { console.log(ok ? 'PASS' : 'FAIL', name); if (!ok) fail++; };
const src = `Guten Morgen.\n\n[[Arena Action]]\nThe ARENA...\n\n[[A Campsite Opportunity]]\nHere...\n\n[[Indeland]]\nx\n\n[[Today, Mon Nov 2]]\ny\n\n[[Thu, Nov 5]]\nz`;
const de = src.replace('The ARENA', 'Die ARENA');
const ok = `Guten Morgen.\n\n[[Action in der Arena]]\nDie ARENA...\n\n[[Ein Campingplatz zu haben]]\nHier...\n\n[[Today, Mon Nov 2]]\ny`;
const a = untranslatedHeaders(src, de);
t('English story headers found', a.length === 2 && a.includes('A Campsite Opportunity') && a.includes('Arena Action'));
t('one-word proper noun header left alone', !a.includes('Indeland'));
t('day headers left alone', !a.some((h) => /Nov/.test(h)));
t('translated headers pass', untranslatedHeaders(src, ok).length === 0);
process.exit(fail ? 1 : 0);
